---
import { Image } from "astro:assets";
import Prose from "../components/Prose.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { hobbies } from "./hobbies/hobbies";
import HobbyCard from "../components/HobbyCard.astro";
import ServiceCard from "../components/ServiceCard.astro";
import ProjectCard from "../components/ProjectCard.astro";
import { projects } from "./projects/projects";
---

<BaseLayout
  title="Wazeer Azizan | Your Full Stack Engineer from Malaysia"
  description="Welcome to Wazeer Azizan portfolio. Explore my skills in Front-end engineering, web development, and my latest projects."
>
  <div class="container">
    <div class="mb-10 w-full gap-16 md:flex md:items-center">
      <div class="text-pretty leading-9">
        <h1 class="mb-4 text-3xl font-bold">Hi There 👋, Wazeer Here!</h1>
        <Prose>
          <div class="text-lg">
            <p>
              I am a Full Stack Engineer from Malaysia. I build fast, responsive
              corporate websites and web apps using modern JavaScript (React,
              Vue), Astro and Wordpress. Currently, I'm working on my portfolio
              and blog. This portfolio and blog is powered by Astro. I'm just
              starting to learn Astro. The major stack I use is ReactJS, VueJs,
              NuxtJS, and TailwindCSS.
            </p>
            <p>
              I also do for Back-end. I use NodeJS, ExpressJS, PrismaORM,
              Sequelize, MongoDB, and Mongoose. So I can build RESTful API. For
              now, not many open source projects are available. I'm always
              looking for new idea to start it.
            </p>
            <p>
              But I'm free to do freelance or part-time work. I can help you
              with your project. I can also help you with your idea. If you want
              to work with me, please contact me. I'll be happy to help you.
            </p>
          </div>
        </Prose>
      </div>

      <Image
        src="/wazeer.webp"
        alt="Muhammad Wazeer Azizan"
        title="Wazeer Azizan"
        width={300}
        height={300}
        class="mx-4 -rotate-3 rounded-3xl md:mx-0"
      />
    </div>

    <div class="mb-12 mt-6">
      <div class="mb-1 flex justify-between gap-2">
        <h2 class="mb-3 text-lg font-bold">My Stack</h2>
      </div>
      <ul class="flex flex-wrap items-center gap-4">
        <li class="rounded-xl border p-4 dark:border-zinc-700 dark:bg-white/90">
          <Image
            src="/vue-svgrepo-com.svg"
            alt="VueJS"
            title="VueJS"
            width={32}
            height={32}
          />
        </li>
        <li class="rounded-xl border p-4 dark:border-zinc-700 dark:bg-white/90">
          <Image
            src="/react-javascript-js-framework-facebook-svgrepo-com.svg"
            alt="ReactJS"
            title="ReactJS"
            width={32}
            height={32}
          />
        </li>
        <li class="rounded-xl border p-4 dark:border-zinc-700 dark:bg-white/90">
          <Image
            src="/wordpress-svgrepo-com.svg"
            alt="Wordpress"
            title="Wordpress"
            width={32}
            height={32}
          />
        </li>
        <li class="rounded-xl border p-4 dark:border-zinc-700 dark:bg-white/90">
          <Image
            src="/nuxt-svgrepo-com.svg"
            alt="NuxtJS"
            title="NuxtJS"
            width={32}
            height={32}
          />
        </li>
        <li class="rounded-xl border p-4 dark:border-zinc-700 dark:bg-white/90">
          <Image
            src="/mysql-logo-svgrepo-com.svg"
            alt="MySQL"
            title="MySQL"
            width={32}
            height={32}
          />
        </li>
        <li class="rounded-xl border p-4 dark:border-zinc-700 dark:bg-white/90">
          <Image
            src="/express-svgrepo-com.svg"
            alt="ExpressJS"
            title="ExpressJS"
            width={32}
            height={32}
          />
        </li>
        <li class="rounded-xl border p-4 dark:border-zinc-700 dark:bg-white/90">
          <Image
            src="/icons8-mongodb.svg"
            alt="MongoDB"
            title="MongoDB"
            width={32}
            height={32}
          />
        </li>
        <li class="rounded-xl border p-4 dark:border-zinc-700 dark:bg-white/90">
          <Image
            src="/icons8-tailwind-css.svg"
            alt="TailwindCSS"
            title="TailwindCSS"
            width={32}
            height={32}
          />
        </li>
        <li class="rounded-xl border p-4 dark:border-zinc-700 dark:bg-white/90">
          <Image
            src="/icons8-prisma-orm.svg"
            alt="PrismaORM"
            title="PrismaORM"
            width={32}
            height={32}
          />
        </li>
        <li class="rounded-xl border p-4 dark:border-zinc-700 dark:bg-white/90">
          <Image
            src="/Sequelize.svg"
            alt="Sequelize"
            title="Sequelize"
            width={32}
            height={32}
          />
        </li>
        <li class="rounded-xl border p-4 dark:border-zinc-700 dark:bg-white/90">
          <Image
            src="/Node.js.svg"
            alt="NodeJS"
            title="NodeJS"
            width={32}
            height={32}
          />
        </li>
      </ul>
    </div>

    <!-- Services Section -->
    <div class="mb-12 mt-6">
      <div
        class="mb-1 flex items-center justify-between gap-2 border-b dark:border-b-zinc-700"
      >
        <h2 class="mb-3 text-lg font-bold">Services</h2>
      </div>
      <p class="text-base">
        I provide tailored solutions for corporate teams who need reliable,
        secure, and scalable web experiences. From high-performing corporate
        websites to robust web apps and business system integrations, I align
        technology with your goals to deliver measurable outcomes.
      </p>
      <div class="mt-4 grid grid-cols-12 gap-5">
        <ServiceCard
          title="Corporate Website Development"
          description="SEO-optimized WordPress and Astro sites that load fast, rank better, and convert visitors."
          technologies={["WordPress", "Astro", "TailwindCSS", "SEO"]}
          ctaText="Request Website Proposal"
          ctaHref="/about"
        >
          <svg
            slot="icon"
            xmlns="http://www.w3.org/2000/svg"
            width="24"
            height="24"
            viewBox="0 0 24 24"
          >
            <rect
              x="3"
              y="4"
              width="18"
              height="14"
              rx="2"
              fill="none"
              stroke="currentColor"
              stroke-width="2"></rect>
            <path
              d="M3 18h18M8 22h8"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"></path>
          </svg>
        </ServiceCard>

        <ServiceCard
          title="Web App Development"
          description="Custom dashboards and CRUD applications built with React/Vue and secure Node.js APIs."
          technologies={[
            "React",
            "Vue",
            "Node.js",
            "Express",
            "MongoDB",
            "MySQL",
          ]}
          ctaText="Discuss Your App"
          ctaHref="/about"
        >
          <svg
            slot="icon"
            xmlns="http://www.w3.org/2000/svg"
            width="24"
            height="24"
            viewBox="0 0 24 24"
          >
            <rect
              x="3"
              y="3"
              width="18"
              height="18"
              rx="2"
              fill="none"
              stroke="currentColor"
              stroke-width="2"></rect>
            <rect
              x="6"
              y="7"
              width="6"
              height="4"
              fill="currentColor"
              opacity="0.2"></rect>
            <rect
              x="14"
              y="7"
              width="4"
              height="10"
              fill="currentColor"
              opacity="0.2"></rect>
            <rect
              x="6"
              y="13"
              width="6"
              height="4"
              fill="currentColor"
              opacity="0.2"></rect>
          </svg>
        </ServiceCard>

        <ServiceCard
          title="API Integration"
          description="Connect websites to CRMs, payment gateways, and databases to streamline operations."
          technologies={["REST", "GraphQL", "Stripe", "Prisma", "Sequelize"]}
          ctaText="Plan Integrations"
          ctaHref="/about"
        >
          <svg
            slot="icon"
            xmlns="http://www.w3.org/2000/svg"
            width="24"
            height="24"
            viewBox="0 0 24 24"
          >
            <path
              d="M6 3v6M6 15v6M18 3v6M18 15v6"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"></path>
            <path
              d="M6 12h12"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"></path>
          </svg>
        </ServiceCard>

        <ServiceCard
          title="Maintenance & Support"
          description="Ongoing security updates, monitoring, and performance optimization for long-term reliability."
          technologies={["Security", "Monitoring", "Performance"]}
          ctaText="Start Maintenance"
          ctaHref="/about"
        >
          <svg
            slot="icon"
            xmlns="http://www.w3.org/2000/svg"
            width="24"
            height="24"
            viewBox="0 0 24 24"
          >
            <path
              d="M12 2l7 4v6c0 5-3.6 9-7 10-3.4-1-7-5-7-10V6l7-4z"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linejoin="round"></path>
            <path
              d="M12 8v6"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"></path>
            <path
              d="M9 11h6"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"></path>
          </svg>
        </ServiceCard>
      </div>
    </div>

    <div class="mb-12 mt-6">
      <div class="mb-1 flex items-center justify-between gap-2">
        <h2 class="mb-3 text-lg font-bold">Recent Projects</h2>
      </div>
      <div class="grid grid-cols-12 gap-5">
        {
          projects &&
            projects.length > 0 &&
            projects.map((project) => <ProjectCard {...project} />)
        }
      </div>
    </div>

    <div class="mb-12 mt-6">
      <div class="mb-1 flex justify-between gap-2">
        <h2 class="mb-3 text-lg font-bold">My Hobbies</h2>
        {
          hobbies && hobbies.length > 3 && (
            <a href="/hobbies/" class="text-sm font-bold">
              All My Hobbies
            </a>
          )
        }
      </div>
      <div class="grid grid-cols-12 gap-5">
        {
          hobbies &&
            hobbies.length > 0 &&
            hobbies.map((hobby) => <HobbyCard {...hobby} />)
        }
      </div>
    </div>
  </div>
</BaseLayout>
