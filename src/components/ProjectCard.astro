---
const { tags, name, description, demoLink } = Astro.props
---

<div
	class="col-span-12 rounded-xl border p-5 shadow-sm sm:col-span-6 lg:col-span-4 dark:border-zinc-700"
>
	<div class="flex items-center justify-between">
		<div class="flex flex-wrap gap-2">
			{
				tags.map((tag: any) => (
					<span class="rounded-2xl border border-zinc-300 px-2 py-0.5 text-xs text-zinc-700 no-underline transition-all duration-700 hover:border-zinc-700 dark:border-zinc-700 dark:text-zinc-300 dark:hover:border-zinc-300">
						{tag}
					</span>
				))
			}
		</div>
	</div>

	<div class="mt-3">
		<h3 class="text-lg font-bold">
			<a
				class="text-zinc-800 no-underline transition-colors duration-700 hover:text-zinc-700 dark:text-zinc-200 dark:hover:text-zinc-100"
				href={demoLink}
			>
				{name}
			</a>
		</h3>

		<p class="mt-2 text-sm text-zinc-600 dark:text-zinc-400">
			{description}
		</p>
	</div>
</div>
