---
// Import Swiper styles
import "swiper/css";
import "swiper/css/navigation";
import "swiper/css/pagination";

interface Props {
  slug: string;
  images?: string[];
  title?: string;
  role?: string;
  whatIBuilt?: string;
  techStack?: string[];
  liveSite?: string;
  note?: string;
  createdAt?: Date | string;
}

const props = Astro.props as Props;

// Derive display fields with graceful fallbacks for both shapes
const displayTitle = props.title ?? "Untitled Project";
const displayLink = props.liveSite ?? "#";
const displayRole = props.role ?? "";
const displayDesc = props.whatIBuilt ?? "";
const displayTags = (props.techStack ?? []) as string[];
const displayNote = props.note ?? "";

// Format date (Month, Day, YYYY). Accept Date or string.
function formatDate(value?: Date | string) {
  if (!value) return "";
  const d = typeof value === "string" ? new Date(value) : value;
  try {
    return d.toLocaleString(undefined, {
      month: "short",
      day: "numeric",
      year: "numeric",
    });
  } catch {
    return "";
  }
}

const displayDate = formatDate(props.createdAt);
---

<div
  class="col-span-12 rounded-xl border p-5 shadow-sm sm:col-span-6 lg:col-span-4 dark:border-zinc-700"
>
  <div class="mt-1 space-y-6">
    <div class="space-y-2">
      {
        displayTags.length > 0 && (
          <div class="mt-2 flex flex-wrap gap-2">
            {displayTags.map((tag: string) => (
              <span class="rounded-2xl border border-zinc-300 px-2 py-0.5 text-xs text-zinc-700 no-underline transition-all duration-700 hover:border-zinc-700 dark:border-zinc-700 dark:text-zinc-300 dark:hover:border-zinc-300">
                {tag}
              </span>
            ))}
          </div>
        )
      }

      <h3 class="text-lg font-bold">
        <span
          class="text-zinc-800 line-clamp-2 md:h-14 no-underline transition-colors duration-700 hover:text-zinc-700 dark:text-zinc-200 dark:hover:text-zinc-100"
        >
          {displayTitle}
        </span>
      </h3>

      {
        displayRole && (
          <p class="text-sm text-zinc-600 dark:text-zinc-400">{displayRole}</p>
        )
      }

      {
        displayDesc && (
          <p class="text-sm line-clamp-3 text-zinc-600 dark:text-zinc-400">
            {displayDesc}
          </p>
        )
      }
    </div>

    <div class="mt-4 flex items-center justify-between">
      <button
        type="button"
        class=`project-card-${props.slug} inline-flex items-center gap-1 rounded-full border border-zinc-300 px-2 py-0.5 text-xs font-medium no-underline transition-all duration-700 hover:border-zinc-700 hover:bg-zinc-50 dark:border-zinc-700 dark:hover:border-zinc-300 dark:hover:bg-zinc-800`
      >
        Read More
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="14"
          height="14"
          viewBox="0 0 24 24"
          class="opacity-70"
        >
          <path
            d="M13 5l7 7-7 7M5 12h14"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"></path>
        </svg>
      </button>
    </div>
  </div>
</div>

<!-- Add Popup to show more details -->
<div
  id={`project-modal-${props.slug}`}
  class="fixed inset-0 z-[1000] hidden bg-black/50 p-4 backdrop-blur-sm"
  aria-hidden="true"
  role="dialog"
>
  <div class="flex min-h-full items-center justify-center">
    <div
      class="relative w-full max-w-2xl rounded-xl border bg-white p-6 shadow-lg dark:border-zinc-700 dark:bg-zinc-900"
    >
      <button
        id={`project-modal-close-${props.slug}`}
        aria-label="Close"
        class="absolute right-1 top-1 rounded-full border border-zinc-300 p-1 text-sm transition hover:bg-zinc-50 dark:border-zinc-700 dark:hover:bg-zinc-800"
      >
        ✕
      </button>

      <div class="space-y-3">
        {
          props.images && props.images.length > 0 && (
            <div
              class={`swiper project-images-swiper project-images-${props.slug} mb-4`}
            >
              <div class="swiper-wrapper">
                {props.images.map((image: string) => (
                  <div class="swiper-slide">
                    <img
                      src={image}
                      alt={displayTitle}
                      class="w-full rounded-xl object-cover"
                    />
                  </div>
                ))}
              </div>
              {props.images.length > 1 && (
                <>
                  <div
                    class={`swiper-pagination swiper-pagination-${props.slug}`}
                  />
                  <div
                    class={`swiper-button-next swiper-button-next-${props.slug}`}
                  />
                  <div
                    class={`swiper-button-prev swiper-button-prev-${props.slug}`}
                  />
                </>
              )}
            </div>
          )
        }

        <h3 class="text-xl font-bold text-zinc-900 dark:text-zinc-100">
          {displayTitle}
        </h3>

        <div class="text-sm text-zinc-600 dark:text-zinc-400">
          {displayRole}
        </div>

        <div class="text-sm text-zinc-700 dark:text-zinc-300">
          {displayDesc}
        </div>

        <div class="mt-2 flex flex-wrap gap-2">
          {
            displayTags.map((tag: string) => (
              <span class="rounded-2xl border border-zinc-300 px-2 py-0.5 text-xs text-zinc-700 no-underline transition-all duration-700 hover:border-zinc-700 dark:border-zinc-700 dark:text-zinc-300 dark:hover:border-zinc-300">
                {tag}
              </span>
            ))
          }
        </div>

        {
          displayLink && displayLink !== "#" && (
            <div class="mt-4 flex items-center justify-between">
              <a
                id={`project-modal-link-${props.slug}`}
                href={displayLink}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center gap-1 rounded-full border border-zinc-300 px-2 py-1 text-xs font-medium no-underline transition-all duration-700 hover:border-zinc-700 hover:bg-zinc-50 dark:border-zinc-700 dark:hover:border-zinc-300 dark:hover:bg-zinc-800"
              >
                Visit
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  width="14"
                  height="14"
                  viewBox="0 0 24 24"
                  class="opacity-70"
                >
                  <path
                    d="M13 5l7 7-7 7M5 12h14"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  />
                </svg>
              </a>
            </div>
          )
        }

        <div class="mt-2 text-xs text-zinc-300 dark:text-zinc-700">
          {displayNote}
        </div>
      </div>
    </div>
  </div>
</div>

<style>
  .project-images-swiper {
    width: 100%;
    max-height: 400px;
  }

  .project-images-swiper .swiper-slide {
    display: flex;
    justify-content: center;
    align-items: center;
  }

  .project-images-swiper .swiper-slide img {
    max-height: 400px;
    width: 100%;
    object-fit: cover;
  }

  .project-images-swiper .swiper-button-next,
  .project-images-swiper .swiper-button-prev {
    color: #84cc16;
    background: rgba(0, 0, 0, 0.5);
    width: 40px;
    height: 40px;
    border-radius: 50%;
    backdrop-filter: blur(4px);
  }

  .project-images-swiper .swiper-button-next:after,
  .project-images-swiper .swiper-button-prev:after {
    font-size: 16px;
    font-weight: bold;
  }

  .project-images-swiper .swiper-pagination-bullet {
    background: #84cc16;
    opacity: 0.7;
  }

  .project-images-swiper .swiper-pagination-bullet-active {
    opacity: 1;
    background: #84cc16;
  }

  @media (prefers-color-scheme: dark) {
    .project-images-swiper .swiper-button-next,
    .project-images-swiper .swiper-button-prev {
      background: rgba(255, 255, 255, 0.2);
    }

    .project-images-swiper .swiper-pagination-bullet {
      background: #e5e7eb;
    }

    .project-images-swiper .swiper-pagination-bullet-active {
      background: #84cc16;
    }
  }
</style>

<script>
  import Swiper from "swiper";
  import { Navigation, Pagination } from "swiper/modules";
  // Initialize Swiper when modal opens
  document.addEventListener("DOMContentLoaded", function () {
    // Get all project cards on the page
    const projectCards = document.querySelectorAll('[class*="project-card-"]');

    projectCards.forEach((card) => {
      // Extract slug from class name
      const slugMatch = card.className.match(/project-card-([\w-]+)/);
      if (!slugMatch) return;

      const slug = slugMatch[1];
      const projectModal = document.querySelector(`#project-modal-${slug}`);
      const projectModalClose = document.querySelector(
        `#project-modal-close-${slug}`
      );

      if (card && projectModal) {
        card.addEventListener("click", (e) => {
          // Allow anchor clicks to navigate, open modal otherwise
          if (e.target instanceof Element && e.target.closest("a")) return;

          // Show modal
          projectModal.classList.remove("hidden");
          projectModal.setAttribute("aria-hidden", "false");

          // Initialize Swiper if images exist and Swiper is available
          const swiperContainer = document.querySelector(
            `.project-images-${slug}`
          );
          if (swiperContainer && Swiper) {
            // Check if Swiper is already initialized
            if (!(swiperContainer as any).swiper) {
              new Swiper(swiperContainer as HTMLElement, {
                modules: [Navigation, Pagination],
                loop: true,
                navigation: {
                  nextEl: `.swiper-button-next-${slug}`,
                  prevEl: `.swiper-button-prev-${slug}`,
                },
                pagination: {
                  el: `.swiper-pagination-${slug}`,
                  clickable: true,
                },
                spaceBetween: 10,
                centeredSlides: true,
              });
            }
          }
        });

        // Add event listener to close modal
        if (projectModalClose) {
          projectModalClose.addEventListener("click", () => {
            projectModal.classList.add("hidden");
            projectModal.setAttribute("aria-hidden", "true");
          });
        }
      }
    });
  });
</script>
